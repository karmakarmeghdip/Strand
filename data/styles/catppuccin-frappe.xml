<?xml version="1.0" encoding="UTF-8"?>
<!--
  Catppuccin Frappé style scheme for GtkSourceView 5 / Strand
  Derived from Helix editor theme (reference/helix/runtime/themes/catppuccin_frappe.toml)
-->
<style-scheme id="catppuccin-frappe" _name="Catppuccin Frappé" version="1.0">
  <author>Catppuccin Org / Strand</author>
  <_description>Soothing pastel theme for the high-spirited (Frappé)</_description>

  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">catppuccin-latte</property>
  </metadata>

  <!-- Named Colors -->
  <color name="rosewater" value="#f2d5cf"/>
  <color name="flamingo"  value="#eebebe"/>
  <color name="pink"      value="#f4b8e4"/>
  <color name="mauve"     value="#ca9ee6"/>
  <color name="red"       value="#e78284"/>
  <color name="maroon"    value="#ea999c"/>
  <color name="peach"     value="#ef9f76"/>
  <color name="yellow"    value="#e5c890"/>
  <color name="green"     value="#a6d189"/>
  <color name="teal"      value="#81c8be"/>
  <color name="sky"       value="#99d1db"/>
  <color name="sapphire"  value="#85c1dc"/>
  <color name="blue"      value="#8caaee"/>
  <color name="lavender"  value="#babbf1"/>

  <color name="text"      value="#c6d0f5"/>
  <color name="subtext1"  value="#b5bfe2"/>
  <color name="subtext0"  value="#a5adce"/>
  <color name="overlay2"  value="#949cbb"/>
  <color name="overlay1"  value="#838ba7"/>
  <color name="overlay0"  value="#737994"/>
  <color name="surface2"  value="#626880"/>
  <color name="surface1"  value="#51576d"/>
  <color name="surface0"  value="#414559"/>
  <color name="base"      value="#303446"/>
  <color name="mantle"    value="#292c3c"/>
  <color name="crust"     value="#232634"/>

  <color name="cursorline"       value="#3b3f52"/>
  <color name="secondary_cursor" value="#b8a5a6"/>

  <!-- Global Styles -->
  <style name="text"                  foreground="text" background="base"/>
  <style name="selection"             background="surface1"/>
  <style name="selection-unfocused"   background="surface0"/>
  <style name="cursor"                foreground="rosewater"/>
  <style name="secondary-cursor"      foreground="secondary_cursor"/>
  <style name="current-line"          background="cursorline"/>
  <style name="line-numbers"          foreground="surface1" background="base"/>
  <style name="current-line-number"   foreground="lavender" background="cursorline"/>
  <style name="draw-spaces"           foreground="overlay0"/>
  <style name="background-pattern"    background="mantle"/>
  <style name="bracket-match"         foreground="peach" background="surface1" bold="true"/>
  <style name="bracket-mismatch"      foreground="red" background="surface1" bold="true"/>
  <style name="right-margin"          foreground="surface0" background="surface0"/>
  <style name="search-match"          foreground="text" background="surface2"/>

  <!-- Default Syntax Highlighting -->
  <style name="def:comment"              foreground="overlay2" italic="true"/>
  <style name="def:shebang"              foreground="overlay2" bold="true"/>
  <style name="def:doc-comment-element"  foreground="subtext1" italic="true"/>
  <style name="def:constant"             foreground="peach"/>
  <style name="def:special-char"         foreground="pink"/>
  <style name="def:string"               foreground="green"/>
  <style name="def:character"            foreground="teal"/>
  <style name="def:number"               foreground="peach"/>
  <style name="def:floating-point"       foreground="peach"/>
  <style name="def:decimal"              foreground="peach"/>
  <style name="def:base-n-integer"       foreground="peach"/>
  <style name="def:boolean"              foreground="peach"/>
  <style name="def:identifier"           foreground="text"/>
  <style name="def:function"             foreground="blue"/>
  <style name="def:builtin"              foreground="red"/>
  <style name="def:keyword"              foreground="mauve"/>
  <style name="def:statement"            foreground="mauve" italic="true"/>
  <style name="def:operator"             foreground="sky"/>
  <style name="def:type"                 foreground="yellow"/>
  <style name="def:preprocessor"         foreground="yellow"/>
  <style name="def:error"                foreground="red" underline="error"/>
  <style name="def:warning"              foreground="yellow" underline="error"/>
  <style name="def:note"                 foreground="sky" bold="true"/>
  <style name="def:heading"              foreground="red" bold="true"/>
  <style name="def:list-marker"          foreground="teal" bold="true"/>
  <style name="def:link-text"            foreground="lavender"/>
  <style name="def:link-destination"     foreground="blue" italic="true" underline="single"/>
  <style name="def:emphasis"             italic="true"/>
  <style name="def:strong-emphasis"      bold="true"/>
  <style name="def:inline-code"          foreground="green"/>
  <style name="def:insertion"            underline="single"/>
  <style name="def:deletion"             strikethrough="true"/>
  <style name="def:underlined"           underline="single"/>

  <!-- Rust Overrides -->
  <style name="rust:attribute"           foreground="yellow"/>
  <style name="rust:lifetime"            foreground="sapphire"/>
  <style name="rust:macro"               foreground="rosewater"/>
  <style name="rust:scope"               foreground="yellow" italic="true"/>
  <style name="rust:identifier"          foreground="red"/>
  <style name="rust:keyword"             foreground="mauve"/>

  <!-- Diff Overrides -->
  <style name="diff:added-line"          foreground="green"/>
  <style name="diff:removed-line"        foreground="red"/>
  <style name="diff:changed-line"        foreground="blue"/>
  <style name="diff:diff-file"           foreground="yellow"/>
  <style name="diff:location"            foreground="sapphire"/>

  <!-- XML / HTML / CSS / JSON -->
  <style name="xml:element-name"         foreground="blue"/>
  <style name="xml:attribute-name"       foreground="yellow"/>
  <style name="xml:attribute-value"      foreground="green"/>
  <style name="xml:namespace"            foreground="yellow" italic="true"/>
  <style name="json:keyname"             foreground="blue"/>
  <style name="css:property-name"        foreground="blue"/>
  <style name="css:type-selector"        foreground="yellow"/>
  <style name="css:id-selector"          foreground="blue" bold="true"/>
  <style name="css:class-selector"       foreground="yellow"/>
</style-scheme>
